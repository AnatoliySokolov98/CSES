#!/usr/bin/env python3
"""Build, run, and sample-test standalone CSES solutions in C++ and Rust (Python stdlib only)."""
import argparse
import difflib
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent
BUILD = ROOT / "build"

CPP_INCLUDE = '#include "template.hpp"'
CPP_FLAGS = ["-std=c++23", "-Wall", "-Wextra", "-Wshadow"]
CPP_RELEASE = ["-O2"]
CPP_DEBUG = ["-O1", "-g", "-D_GLIBCXX_ASSERTIONS", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-fno-sanitize-recover=all"]
RUST_FLAGS = ["--edition=2021", "--crate-name", "cses_solution"]
RUST_RELEASE = ["-O"]
RUST_DEBUG = ["-g", "-Copt-level=1", "-Cdebug-assertions=on", "-Coverflow-checks=on"]

STUBS = {
    ("cpp", False): f"{CPP_INCLUDE}\n\nint main() {{\n}}\n",
    ("cpp", True): f"{CPP_INCLUDE}\n\nint main() {{\n    // Interactive: flush after every query with std::endl or std::cout.flush().\n}}\n",
    ("rust", False): 'fn solve(_it: &mut std::str::SplitWhitespace<\'_>, _out: &mut impl std::io::Write) {\n    todo!("Implement solution");\n}\n',
    ("rust", True): 'fn solve(_input: &mut impl std::io::BufRead, _out: &mut impl std::io::Write) {\n    todo!("Implement interactive solution");\n}\n',
}
LANGS = {"cpp": ("C++", "solution.cpp"), "rust": ("Rust", "solution.rs")}
ALIASES = {"cpp": "cpp", "c++": "cpp", "rust": "rust", "rs": "rust"}


def header(p):
    return f'// {p["name"]} — https://cses.fi/problemset/task/{p["id"]}/\n// Generated by ./cses; edit the source files instead.\n'


def source_note(path):
    return f"// Source: {path.relative_to(ROOT)}\n"


def assemble_cpp(p, folder):
    """Inline the template where the solution includes it, producing one submittable file."""
    solution = folder / "solution.cpp"
    lines = solution.read_text().splitlines(keepends=True)
    hits = [i for i, line in enumerate(lines) if line.strip() == CPP_INCLUDE]
    if len(hits) != 1:
        raise ValueError(f"{solution.relative_to(ROOT)} must contain exactly one line: {CPP_INCLUDE}")
    template = ROOT / "src/template.hpp"
    i = hits[0]
    return header(p) + "".join(lines[:i]) + source_note(template) + template.read_text() + source_note(solution) + "".join(lines[i + 1:])


def assemble_rust(p, folder):
    """Concatenate the shared macros, the runner, and the solution into one submittable file."""
    runner = "interactive_runner.rs" if p.get("interactive") else "runner.rs"
    sources = (ROOT / "src/macros.rs", ROOT / "src" / runner, folder / "solution.rs")
    return header(p) + "\n".join(source_note(s) + s.read_text() for s in sources)


def compile_command(lang, debug, source, binary):
    if lang == "cpp":
        compiler = os.environ.get("CXX", "clang++")
        linker = ["-fuse-ld=lld"] if "clang" in compiler else []
        return [compiler, *CPP_FLAGS, *(CPP_DEBUG if debug else CPP_RELEASE), *linker, str(source), "-o", str(binary)]
    return [os.environ.get("RUSTC", "rustc"), *RUST_FLAGS, *(RUST_DEBUG if debug else RUST_RELEASE), str(source), "-o", str(binary)]


def write_if_changed(path, text):
    if not path.exists() or path.read_text() != text:
        path.write_text(text)


def is_solved(p, lang):
    """A solution counts once it differs from the generated stub."""
    path = ROOT / p["path"] / LANGS[lang][1]
    return path.exists() and path.read_text().strip() != STUBS[lang, bool(p.get("interactive"))].strip()


def build(p, lang, debug):
    """Write the standalone submission and compile exactly that file. Returns its paths, or None on a compile error."""
    folder = ROOT / p["path"]
    slug = folder.name
    extension = "cpp" if lang == "cpp" else "rs"
    destination = BUILD / "submissions" / f"{slug}.{extension}"
    destination.parent.mkdir(parents=True, exist_ok=True)
    write_if_changed(destination, (assemble_cpp if lang == "cpp" else assemble_rust)(p, folder))
    binary = BUILD / "bin" / ("debug" if debug else "release") / lang / slug
    binary.parent.mkdir(parents=True, exist_ok=True)
    if not binary.exists() or binary.stat().st_mtime < destination.stat().st_mtime:
        if subprocess.run(compile_command(lang, debug, destination, binary)).returncode != 0:
            binary.unlink(missing_ok=True)
            return None
    return destination, binary


def run_tests(binary, tests, timeout):
    failures = 0
    for source in tests:
        expected_file = source.with_suffix(".out")
        if not expected_file.exists():
            print(f"FAIL {source.stem}: missing {expected_file.name}")
            failures += 1
            continue
        expected = expected_file.read_bytes()
        start = time.perf_counter()
        try:
            result = subprocess.run([str(binary)], input=source.read_bytes(), capture_output=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            print(f"FAIL {source.stem}: timeout after {timeout:g}s")
            failures += 1
            continue
        elapsed = f"{(time.perf_counter() - start) * 1000:.0f} ms"
        if result.returncode != 0:
            print(f"FAIL {source.stem}: exit {result.returncode} ({elapsed})")
            print(result.stderr.decode(errors="replace"), end="")
            failures += 1
        elif result.stdout.split() != expected.split():
            print(f"FAIL {source.stem}: output mismatch ({elapsed})")
            print("".join(difflib.unified_diff(expected.decode(errors="replace").splitlines(True), result.stdout.decode(errors="replace").splitlines(True), fromfile="expected", tofile="actual")))
            failures += 1
        else:
            print(f"PASS {source.stem} ({elapsed})")
    return failures


def sync(problems):
    """Create missing solution stubs, and the Cargo entry points rust-analyzer uses to discover every solution.rs."""
    bins = ROOT / "src/bin"
    bins.mkdir(parents=True, exist_ok=True)
    created = 0
    for p in problems:
        folder = ROOT / p["path"]
        folder.mkdir(parents=True, exist_ok=True)
        for lang, (_, filename) in LANGS.items():
            if not (folder / filename).exists():
                (folder / filename).write_text(STUBS[lang, bool(p.get("interactive"))])
                created += 1
        runner = "interactive_runner.rs" if p.get("interactive") else "runner.rs"
        write_if_changed(bins / f"{folder.name}.rs", (
            "// Generated by ./cses sync; edit the problem's solution.rs instead.\n"
            '#[path = "../macros.rs"]\nmod macros;\n\n'
            f'include!("../{runner}");\n'
            f'include!("../../{p["path"]}/solution.rs");\n'
        ))
    print(f"Synced {len(problems)} Cargo targets; created {created} solution stubs")


def language(value):
    if value.lower() not in ALIASES:
        raise argparse.ArgumentTypeError("expected cpp or rust")
    return ALIASES[value.lower()]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    listing = commands.add_parser("list", help="list problems and which languages are solved")
    listing.add_argument("--todo", type=language, metavar="LANG", help="only show problems unsolved in this language")
    commands.add_parser("sync", help="create missing stubs and Cargo targets for indexed problems")
    for command in ("run", "test", "submit"):
        sub = commands.add_parser(command)
        sub.add_argument("problem", help="problem slug, CSES ID, or path to its folder or solution file")
        sub.add_argument("-l", "--lang", type=language, help="cpp or rust (default: the solution file given, else every solved language)")
        if command == "run":
            sub.add_argument("--input", help="input file, or - for stdin")
        if command in ("run", "test"):
            sub.add_argument("--timeout", type=float, default=5, help="execution timeout in seconds (default: 5)")
            sub.add_argument("--debug", action="store_true", help="C++: sanitizers and assertions; Rust: overflow checks and debug assertions")
    args = parser.parse_args()
    problems = json.loads((ROOT / "problems/index.json").read_text())

    if args.command == "sync":
        sync(problems)
        return 0
    if args.command == "list":
        solved = {lang: 0 for lang in LANGS}
        for p in problems:
            marks = {lang: is_solved(p, lang) for lang in LANGS}
            for lang in LANGS:
                solved[lang] += marks[lang]
            if args.todo and marks[args.todo]:
                continue
            flags = " ".join(LANGS[lang][0] if marks[lang] else "·" * len(LANGS[lang][0]) for lang in LANGS)
            print(f'{p["id"]:>4}  {flags}  {Path(p["path"]).name}  ({p["category"]})')
        print("Solved: " + ", ".join(f"{LANGS[lang][0]} {solved[lang]}/{len(problems)}" for lang in LANGS))
        return 0

    target = Path(args.problem).resolve()
    folder_arg = target.parent if target.is_file() else target
    matches = [p for p in problems if args.problem in (p["id"], Path(p["path"]).name, p["path"]) or folder_arg == ROOT / p["path"]]
    if len(matches) != 1:
        parser.error("unknown or ambiguous problem; use ./cses list")
    p = matches[0]
    if args.command == "test" and p.get("interactive"):
        parser.error("Interactive task: tests/example-transcript.txt is a conversation, not a test pair. A live interactor is required.")
    file_lang = {"solution.cpp": "cpp", "solution.rs": "rust"}.get(target.name) if target.is_file() else None
    if args.lang or file_lang:
        langs = [args.lang or file_lang]
    else:
        langs = [lang for lang in LANGS if is_solved(p, lang)]
        if not langs:
            parser.error("neither solution.cpp nor solution.rs has been written yet; pass --lang to use a stub anyway")
    if getattr(args, "timeout", 1) <= 0:
        parser.error("--timeout must be positive")
    stdin_input = None
    if getattr(args, "input", None) == "-" and len(langs) > 1:
        if p.get("interactive"):
            parser.error("pick one language with --lang to talk to an interactor")
        stdin_input = sys.stdin.buffer.read()  # read once so every language gets the same input

    status = 0
    for lang in langs:
        if len(langs) > 1:
            print(f"== {LANGS[lang][0]} ==", flush=True)
        built = build(p, lang, getattr(args, "debug", False))
        if built is None:
            status = 1
            continue
        destination, binary = built
        if args.command == "submit":
            print(destination)
        elif args.command == "run":
            if args.input == "-":
                code = subprocess.run([str(binary)], input=stdin_input, timeout=args.timeout).returncode
            else:
                with (Path(args.input) if args.input else ROOT / p["path"] / "input.txt").open("rb") as stream:
                    code = subprocess.run([str(binary)], stdin=stream, timeout=args.timeout).returncode
            if code != 0:
                print(f"exit {code}", file=sys.stderr)
                status = 1
        else:
            tests = sorted((ROOT / p["path"] / "tests").glob("*.in"))
            if not tests:
                raise ValueError("No tests found; add tests/<name>.in and tests/<name>.out")
            failures = run_tests(binary, tests, args.timeout)
            print(f"{len(tests) - failures}/{len(tests)} passed")
            status |= failures > 0
    if args.command == "test":
        print("Compared whitespace-separated tokens; constructive problems may have other valid outputs.")
    return int(status)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:  # e.g. ./cses list | head
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
